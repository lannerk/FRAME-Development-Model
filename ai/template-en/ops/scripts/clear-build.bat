@echo off
chcp 65001 >nul
rem clear-build: remove dependency and build-output directories (node_modules, dist, ...) across the repo, only what git ignores.
rem Same criterion as clear-build.sh; the reasons are in that file's comments.
rem Usage: double-click; or on a command line  ops\scripts\clear-build.bat [/y]   (/y = delete without asking)
rem The project has other build directory names: set CLEAR_BUILD_EXTRA=name name  first; do not edit this file.
setlocal EnableExtensions EnableDelayedExpansion
set "GIT_OPTIONAL_LOCKS=0"
set "YES=0"
if /i "%~1"=="/y" set "YES=1"
if /i "%~1"=="-y" set "YES=1"
set "ROOT="
for /f "delims=" %%r in ('git -C "%~dp0." rev-parse --show-toplevel 2^>nul') do set "ROOT=%%r"
if not defined ROOT (
  echo Not inside a git repository, or git is not installed.
  goto :end
)
cd /d "%ROOT%"
set "NAMES=node_modules dist build out .next .nuxt .svelte-kit .turbo .vite .parcel-cache .cache coverage __pycache__ .pytest_cache %CLEAR_BUILD_EXTRA%"
set "LIST=%TEMP%\clear-build-%RANDOM%%RANDOM%.txt"
type nul > "%LIST%"
set "N=0"
for /f "delims=" %%p in ('git -c core.quotepath^=false ls-files --others --ignored --exclude-standard --directory 2^>nul') do (
  set "P=%%p"
  if "!P:~-1!"=="/" (
    set "D=!P:~0,-1!"
    set "D=!D:/=\!"
    set "B="
    for %%b in ("!D!") do set "B=%%~nxb"
    set "HIT="
    for %%n in (!NAMES!) do if /i "!B!"=="%%n" set "HIT=1"
    if /i "!D!"=="dist" set "HIT="
    if defined HIT (
      set "T="
      for /f "delims=" %%x in ('git ls-files -- "!D!" 2^>nul') do set "T=1"
      if defined T (
        echo   skipped, holds git-tracked files: !D!
      ) else (
        >>"%LIST%" echo !D!
        set /a N+=1
      )
    )
  )
)
if "%N%"=="0" (
  echo CLEAR-BUILD-OK: no build directory to clean
  goto :end
)
echo These %N% directories are ignored by git and named like dependencies or build output; they can go:
for /f "usebackq delims=" %%d in ("%LIST%") do echo   %%d
if "%YES%"=="1" goto :do
set "A="
set /p "A=Delete them? Type y and press Enter: "
if /i not "!A!"=="y" (
  echo Nothing deleted.
  goto :end
)
:do
set "F=0"
for /f "usebackq delims=" %%d in ("%LIST%") do (
  if exist "%%d\" rd /s /q "%%d"
  if exist "%%d\" (
    echo   could not delete: %%d
    set /a F+=1
  )
)
if "%F%"=="0" (echo CLEAR-BUILD-OK: deleted %N% directories; reinstall dependencies and rebuild when needed) else (echo CLEAR-BUILD-FAIL: %F% could not be deleted, usually a file in use or a path too long)
:end
if exist "%LIST%" del "%LIST%" >nul 2>&1
if "%YES%"=="0" pause
endlocal
